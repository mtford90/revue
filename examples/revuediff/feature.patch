+type GreetingOptions = {
+  excited?: boolean;
+};
+
+export function formatGreeting(name: string, options: GreetingOptions = {}): string {
+  const subject = name.trim() || "friend";
+  const punctuation = options.excited ? "!" : ".";
+  return `Hello, ${subject}${punctuation}`;
 }
